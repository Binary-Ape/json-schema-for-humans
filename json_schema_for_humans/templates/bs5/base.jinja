{% from 'content.jinja' import content with context %}
{% set theme = 'dark' %}
<!DOCTYPE html>
<html lang="en" data-bs-theme="{{ theme }}" class="min-vh-100">
<head>
    <link rel="stylesheet" type="text/css" href="css/font_style.css">
    <link rel="stylesheet" type="text/css" href="css/DarkGray.css" title="DarkGray">
    {% if config.offline %}
        <link rel="stylesheet" type="text/css" href="css/bootstrap-{{ config.bs_version }}.min.css">
    {% else %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@{{ config.bs_version }}/dist/css/bootstrap.min.css"
              rel="stylesheet"
              integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT"
              crossorigin="anonymous">
    {% endif %}
    <link rel="stylesheet" type="text/css" href="css/custom.css">

    <meta charset="utf-8"/>
    {%- set title = schema.keywords.get("title") -%}
    {% if title %}
        {% set title = title.literal %}
    {% endif %}
    <title>{%- if title -%}{{ title }}{%- else -%}Schema Docs{%- endif -%}</title>
</head>
<body {% if config.bs5_js %}onload="anchorOnLoad();" {% endif %} id="root" class="d-flex flex-column min-vh-100">

    <header {% if config.navbar_sticky %}class ="navigation sticky-lg-top" {% endif %}>
        {%- if config.navbar -%}
            <nav class="navbar navbar-expand-md {% if navbar_bottom %}fixed-bottom{% endif %} bg-body-secondary d-flex min-vw-100 justify-content-between px-md-3 px-2">
                {%- if schema.title -%}
                    <a class="navbar-brand me-0 flex-shrink-1 text-truncate" href="#">{{ schema.title }}</a>
                {%- endif -%}

                {% if config.search %}
                    <form id="PropertySearch"
                          class="position-absolute translate-middle start-50 top-50 d-flex w-50 ps-3">
                        <input id="property_search" list="property_autocomplete" class="form-control" type="search"
                               placeholder="Property Search" aria-label="Search" onkeyup="SearchInput(this.value)">
                        <datalist id="property_autocomplete"></datalist>
                        {%- if  config.instant_search -%}
                            <button class="btn btn-secondary" type="submit">Search</button>
                        {% endif %}
                    </form>
                {% endif %}

                {%- if config.expand_buttons -%}
                    {% if config.bs5_js %}
                        <div class="btn-group d-none d-md-block flex-shrink-0 ps-3" role="group"
                             aria-label="Expand All / Collapse All">
                            <button class="btn btn-secondary btn-sm" type="button" data-bs-toggle="collapse"
                                    data-bs-target=".collapse:not(.show, .accordion-item)"
                                    aria-expanded="false">Expand all
                            </button>
                            <button class="btn btn-secondary btn-sm" type="button" data-bs-toggle="collapse"
                                    data-bs-target=".collapse.show:not(.accordion-item)"
                                    aria-expanded="false">Collapse all
                            </button>
                        </div>
                    {% else %}
                        <div class="btn-group d-none d-md-block flex-shrink-0 ps-3" role="group"
                             aria-label="Expand All / Collapse All">
                        <input autocomplete="off" type="checkbox" class="btn-check" id="ExpandCollapseButton"></input>
                        <label for="ExpandCollapseButton" class="btn btn-outline-secondary btn-sm">
                            Expand All
                        </label>
                    {% endif %}

                {%- endif -%}

            </nav>
        {%- endif -%}
    </header>


    <main class="flex-grow-1 py-3">
        <div class="container">
            {{ content(schema, skip_headers=True, skip_title=True, search_bar=True) }}
        </div>
    </main>

    <footer class="footer {% if config.footer_sticky %}sticky-bottom{% endif %} bottom py-1 bg-body-secondary">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            {% if config.with_footer -%}
                <div id="GeneratedFooter">
                    Generated using <a
                        href="https://github.com/coveooss/json-schema-for-humans">json-schema-for-humans</a>
                    {%- if config.footer_show_time %} on {{ get_local_time() }} {%- endif -%}
                </div>
            {%- endif -%}
            {% if config.themes and config.bs5_js %}
                <div class="dropup">
                    <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown"
                            aria-expanded="false" id="btnThemeSwitcher">
                        <span id="btnThemeName"></span>
                    </button>
                    <ul class="dropdown-menu" id="themes">
                        <li><h6 class="dropdown-header">Available Themes</h6></li>
                        <li>
                            <button value="dark" class="dropdown-item default-option"
                                    onclick="toggle_theme(this.value)">
                                Dark
                            </button>
                        </li>
                        <li>
                            <button value="light" class="dropdown-item" onclick="toggle_theme(this.value)">Light
                            </button>
                        </li>
                    </ul>
                </div>
            {% endif %}
        </div>
    </footer>

{% if config.bs5_js %}
    <script src="js/schema_doc.min.js"></script>
    <script src="js/Search.js"></script>
    <script src="js/ThemeSwitcher.js"></script>
    {% if config.offline %}
        <script src="js/bootstrap-{{ config.bs_version }}.bundle.js"></script>
    {% else %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@{{ config.bs_version }}/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO"
                crossorigin="anonymous"></script>
    {% endif %}
{% endif %}
</body>
</html>
